# Local development
# Prefer Docker Postgres, or paste a Neon/Railway Postgres URL below.

DATABASE_URL=postgresql://mandate:mandate@localhost:5432/mandate
ENCRYPTION_KEY=replace-with-32-plus-random-characters
# Set only while migrating secrets sealed with the old SESSION_SECRET.
LEGACY_ENCRYPTION_KEY=
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
# Optional networkless JWT verification key from Clerk.
CLERK_JWT_KEY=
# Optional existing Agency.id to claim during the first Clerk onboarding.
CLERK_LEGACY_AGENCY_ID=
PUBLIC_BASE_URL=http://localhost:8788
APP_ORIGINS=http://localhost:8788
AGENCY_NAME=Fieldnote Automation
AGENCY_TIMEZONE=America/Denver
ALERT_EMAIL_TO=ops@example.com
PORT=8788

STANDALONE=1
EMAIL_CONSOLE=1

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Mandate <alerts@mandate.local>

VITE_API_BASE_URL=
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Production hosts auto-set PUBLIC_BASE_URL from:
#   RAILWAY_PUBLIC_DOMAIN  or  RENDER_EXTERNAL_URL
