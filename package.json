{
  "name": "mandate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/src/dev.ts",
    "dev:api": "tsx watch server/src/dev.ts",
    "dev:vite": "vite",
    "worker": "tsx watch server/src/workers/budget-alerts.ts",
    "build": "tsc -b && vite build && tsc -p server/tsconfig.json",
    "preview": "vite preview",
    "start": "node scripts/start.mjs",
    "start:api": "node server/dist/index.js",
    "start:prod": "node scripts/start.mjs",
    "start:worker": "node server/dist/workers/budget-alerts.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reencrypt-secrets": "tsx scripts/reencrypt-secrets.ts",
    "docker:up": "docker compose up -d postgres",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "validate:promo": "tsx scripts/full-promo-validation.ts"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.9",
    "@clerk/fastify": "^3.1.56",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.1.0",
    "@fastify/middie": "^9.3.3",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.2",
    "@prisma/client": "^6.14.0",
    "dotenv": "^17.2.1",
    "fastify": "^5.4.0",
    "lucide-react": "^1.25.0",
    "nodemailer": "^9.0.3",
    "prisma": "^6.14.0",
    "puppeteer": "^24.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^3.2.4"
  }
}
