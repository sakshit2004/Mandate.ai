generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BudgetPeriod {
  daily
  weekly
  monthly
}

enum AgencyStatus {
  ACTIVE
  DISABLED
}

enum MembershipRole {
  ADMIN
  MEMBER
}

enum FundingMode {
  BYOK
  MANDATE_PROMO
}

model Agency {
  id                  String        @id @default(cuid())
  clerkOrganizationId String?       @unique
  name                String
  timezone            String        @default("America/Denver")
  status              AgencyStatus  @default(ACTIVE)
  setupComplete       Boolean       @default(false)
  /// null until admin chooses BYOK vs Mandate promo on onboarding.
  fundingMode         FundingMode?
  promoClientClaimed  Boolean       @default(false)
  openaiConfigured    Boolean       @default(false)
  anthropicConfigured Boolean       @default(false)
  /// AES-GCM sealed provider keys (standalone mode — no LiteLLM).
  sealedOpenaiKey     String?
  sealedAnthropicKey  String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  clients             Client[]
  memberships         AgencyMembership[]
  auditEvents         AuditEvent[]
}

model User {
  id           String   @id @default(cuid())
  clerkUserId  String   @unique
  primaryEmail String?
  name         String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  memberships  AgencyMembership[]

  @@index([primaryEmail])
}

model AgencyMembership {
  id                String         @id @default(cuid())
  clerkMembershipId String?        @unique
  agencyId          String
  userId            String
  role              MembershipRole @default(MEMBER)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  agency            Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
  @@index([userId])
}

model AuditEvent {
  id               String   @id @default(cuid())
  agencyId         String
  actorClerkUserId String
  action           String
  targetType       String
  targetId         String?
  metadata         Json?
  createdAt        DateTime @default(now())
  agency           Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, createdAt])
  @@index([actorClerkUserId])
}

model Client {
  id             String       @id @default(cuid())
  agencyId       String
  agency         Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  /// SHA-256 of the Mandate virtual key.
  tokenHash      String       @unique
  keyAlias       String       @unique
  keyPrefix      String
  /// AES-256-GCM sealed Mandate key for kill/re-enable after restarts.
  sealedKey      String
  maxBudgetUsd   Float
  budgetPeriod   BudgetPeriod @default(monthly)
  fundingSource  FundingMode  @default(BYOK)
  /// Set for Mandate promo clients; hard-stop after this time.
  promoExpiresAt DateTime?
  killed         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  alerts         BudgetAlert[]
  usageEvents    UsageEvent[]
  reservations   BudgetReservation[]

  @@unique([agencyId, slug])
  @@index([agencyId])
}

model BudgetReservation {
  id             String   @id
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  budgetWindowId String
  amountUsd      Float
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([clientId, budgetWindowId, expiresAt])
}

model UsageEvent {
  id        String   @id @default(cuid())
  requestId String   @unique
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ts        DateTime @default(now())
  provider  String
  model     String
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  costUsd   Float    @default(0)
  status    String   @default("success")
  tag       String?
  createdAt DateTime @default(now())

  @@index([clientId, ts])
  @@index([ts])
}

model BudgetAlert {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  thresholdPct   Int      @default(80)
  budgetWindowId String
  spendUsd       Float
  capUsd         Float
  emailedAt      DateTime @default(now())
  createdAt      DateTime @default(now())

  @@unique([clientId, thresholdPct, budgetWindowId])
  @@index([clientId])
}
